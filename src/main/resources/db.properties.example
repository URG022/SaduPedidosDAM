
# =====================================================================
# Sadu Pedidos - configuracion de la base de datos (PLANTILLA)
#
# 1. Copia este archivo en la MISMA carpeta con el nombre: db.properties
#    (o en tu carpeta personal: ~/.sadu/db.properties, que tiene prioridad)
# 2. Si ejecutaste sql/00_crear_bd_y_usuario.sql, NO cambies nada: el usuario
#    sadu_app y su clave son los que crea ese script.
# 3. Si prefieres usar root, cambia db.user y db.password por los tuyos.
#
# db.properties esta en .gitignore: NUNCA se sube a GitHub.
# =====================================================================
db.url=jdbc:mysql://127.0.0.1:3306/sadu_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/El_Salvador
db.user=sadu_app
db.password=SaduDam2026